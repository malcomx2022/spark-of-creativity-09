# API NestJS (migration PostgreSQL native) — voir api/README.md
# Base des appels HTTP : `/api` par défaut (proxy Vite en développement, Caddy en production)
VITE_API_URL=/api
# Origine du WebSocket Socket.IO (vide = même origine)
VITE_WS_URL=
# Cible du proxy Vite en développement (API locale)
VITE_DEV_API_TARGET=http://localhost:3000

# Supabase (héritage, encore utilisé par les écrans non migrés — retiré à la fin de l'étape 7)
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_SUPABASE_PROJECT_ID="YOUR_SUPABASE_PROJECT_ID"

# FedaPay Configuration (managed via Lovable Cloud secrets)
# FEDAPAY_PUBLIC_KEY - Clé publique FedaPay (utilisable côté client)
# FEDAPAY_SECRET_KEY - Clé secrète FedaPay (serveur uniquement)
# FEDAPAY_WEBHOOK_SECRET - Secret pour vérifier les webhooks
# FEDAPAY_MODE - Mode sandbox ou live
# PLATFORM_WALLET_ID - ID du compte plateforme chez FedaPay
# APP_BASE_URL - URL de base de l'application pour les callbacks (défaut: https://domicares.life)

# Mapbox (pour la géolocalisation)
# VITE_MAPBOX_TOKEN - Token Mapbox pour les cartes

# Twilio Configuration (managed via Lovable Cloud secrets)
# TWILIO_ACCOUNT_SID - Identifiant du compte Twilio
# TWILIO_AUTH_TOKEN - Token d'authentification Twilio
# TWILIO_VERIFY_SERVICE_SID - ID du service Twilio Verify pour OTP
# TWILIO_PHONE_NUMBER - Numéro de téléphone Twilio pour l'envoi de SMS

# Wasabi S3 Storage (managed via Lovable Cloud secrets)
# WASABI_ACCESS_KEY_ID - Clé d'accès Wasabi
# WASABI_SECRET_ACCESS_KEY - Clé secrète Wasabi
# WASABI_BUCKET_NAME - Nom du bucket S3
# WASABI_REGION - Région du bucket (ex: us-east-1)
# WASABI_ENDPOINT - Point de terminaison Wasabi (ex: s3.wasabisys.com)
