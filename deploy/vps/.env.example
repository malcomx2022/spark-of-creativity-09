# ===== Domicares VPS — copier en .env et compléter =====
DOMAIN=domicares.life
ACME_EMAIL=admin@domicares.life

# --- PostgreSQL ---
POSTGRES_DB=domicares
POSTGRES_PASSWORD=change-me-superuser
DOMICARES_APP_PASSWORD=change-me-app        # rôle domicares_app (API)
DOMICARES_MIGRATOR_PASSWORD=change-me-mig   # rôle domicares_migrator (migrations)
PG_SHARED_BUFFERS=1GB
BACKUP_KEEP_DAYS=14

# --- API (api/src/config/config.schema.ts) ---
API_PREFIX=api
FRONTEND_URL=https://domicares.life
CORS_ORIGINS=https://domicares.life
COOKIE_SECURE=true
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_PROVIDER=resend                       # resend | console
OTP_PROVIDER=twilio                         # twilio | fake (fake interdit en production)
SMS_PROVIDER=twilio                         # twilio | console
STORAGE_PROVIDER=s3                         # s3 | fake (fake interdit en production)
S3_FORCE_PATH_STYLE=true                    # true pour MinIO ; false pour Wasabi/AWS virtual-host
FILE_URL_TTL_SECONDS=3600

# --- Auth (remplace Supabase Auth) ---
JWT_ACCESS_SECRET=change-me-64-hex          # openssl rand -hex 32
JWT_ACCESS_TTL_SECONDS=900                  # 15 min
JWT_REFRESH_TTL_SECONDS=2592000             # 30 jours
PHONE_ENCRYPTION_KEY=change-me              # ex secure-phone : AES-256-GCM des numéros Mobile Money (openssl rand -base64 32), obligatoire en production

# --- Paiement FedaPay (ex secrets Edge Functions) ---
FEDAPAY_PROVIDER=fedapay                    # fedapay | fake (fake interdit en production)
FEDAPAY_MODE=sandbox                        # sandbox | live
FEDAPAY_PUBLIC_KEY=pk_sandbox_xxx
FEDAPAY_SECRET_KEY=sk_sandbox_xxx
FEDAPAY_WEBHOOK_SECRET=whsec_xxx            # à régénérer après changement d'URL de webhook : https://<DOMAIN>/api/webhooks/fedapay
JOBS_ENABLED=true                           # ordonnanceur des jobs dans le service worker
PLATFORM_WALLET_ID=
APP_BASE_URL=https://domicares.life

# --- SMS / OTP Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# --- E-mail (Resend utilisé par _shared/notifications.ts) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@domicares.life
NOTIFICATION_EMAIL_FROM=noreply@domicares.life
SITE_URL=https://domicares.life
FRONTEND_URL=https://domicares.life

# --- Push Web (VAPID : npx web-push generate-vapid-keys) ---
PUSH_PROVIDER=webpush                       # webpush | console (console interdit en production)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_EMAIL=mailto:admin@domicares.life

# --- Temps réel (Socket.IO dans l'API, /socket.io routé par Caddy) ---
REALTIME_ENABLED=true

# --- Cartes ---
MAPBOX_TOKEN=

# --- Stockage S3 (MinIO local ou Wasabi) ---
S3_ENDPOINT=http://minio:9000               # ou https://s3.eu-central-1.wasabisys.com
S3_REGION=us-east-1
S3_BUCKET_DOCUMENTS=documents
S3_BUCKET_AVATARS=avatars
S3_BUCKET_ATTACHMENTS=message-attachments
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
