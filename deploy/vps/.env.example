# ===== Domicares VPS — copier en .env et compléter =====
DOMAIN=domicares.life                       # recette : un sous-domaine pointé sur le VPS, ex. staging.domicares.life
WWW_DOMAIN=www.domicares.life               # recette : www.localhost (pas de DNS ⇒ pas de certificat Let's Encrypt)
ACME_EMAIL=admin@domicares.life
# Recette sur le VPS de production (second clone, document 16 §2.6) — UNIQUEMENT dans le .env de recette :
# COMPOSE_PROJECT_NAME=domicares-recette       # jamais « vps » : ce sont les volumes de la production
# COMPOSE_FILE=docker-compose.yml:docker-compose.recette.yml
# RECETTE_API_MEM=768m  RECETTE_WORKER_MEM=512m  RECETTE_POSTGRES_MEM=768m  RECETTE_MINIO_MEM=512m
# PG_SHARED_BUFFERS=192MB                      # recette : au plus un tiers de RECETTE_POSTGRES_MEM (1GB ci-dessous = production)

# --- PostgreSQL ---
POSTGRES_DB=domicares
POSTGRES_PASSWORD=change-me-superuser
DOMICARES_APP_PASSWORD=change-me-app        # rôle domicares_app (API)
DOMICARES_MIGRATOR_PASSWORD=change-me-mig   # rôle domicares_migrator (migrations)
PG_SHARED_BUFFERS=1GB
BACKUP_KEEP_DAYS=14                          # rétention locale (deploy/vps/backups/<STAMP>/)
# Sauvegarde PostgreSQL + objets S3 (backup.sh) ; RPO = intervalle (24 h par défaut).
BACKUP_INTERVAL_SECONDS=86400
# Copie hors site : remote rclone (ex. :s3,provider=Wasabi,access_key_id=…,secret_access_key=…,endpoint=s3.eu-central-1.wasabisys.com:domicares-backups)
# Chiffrement obligatoire : clé publique age (age-keygen ; clé privée conservée HORS du VPS).
BACKUP_OFFSITE_REMOTE=
BACKUP_AGE_RECIPIENT=
BACKUP_OFFSITE_KEEP_DAYS=30
# Alerte d'échec : URL recevant un POST JSON {"text": "..."} (webhook Slack, Mattermost, ntfy…)
BACKUP_ALERT_URL=

# --- API (api/src/config/config.schema.ts) ---
API_PREFIX=api
# Documentation OpenAPI : ouverte hors production, fermée en production. Décommenter pour trancher.
# API_DOCS_ENABLED=true
FRONTEND_URL=https://domicares.life
CORS_ORIGINS=https://domicares.life
COOKIE_SECURE=true
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_PROVIDER=resend                       # resend | console
OTP_PROVIDER=twilio                         # twilio | fake (fake interdit en production)
SMS_PROVIDER=twilio                         # twilio | console
STORAGE_PROVIDER=s3                         # s3 | fake (fake interdit en production)
S3_FORCE_PATH_STYLE=true                    # true pour MinIO ; false pour Wasabi/AWS virtual-host
FILE_URL_TTL_SECONDS=3600

# --- Auth (remplace Supabase Auth) ---
JWT_ACCESS_SECRET=change-me-64-hex          # openssl rand -hex 32
JWT_ACCESS_TTL_SECONDS=900                  # 15 min
JWT_REFRESH_TTL_SECONDS=2592000             # 30 jours
PHONE_ENCRYPTION_KEY=change-me              # ex secure-phone : AES-256-GCM des numéros Mobile Money (openssl rand -base64 32), obligatoire en production

# --- Paiement FedaPay (ex secrets Edge Functions) ---
FEDAPAY_PROVIDER=fedapay                    # fedapay | fake (fake interdit en production)
FEDAPAY_MODE=sandbox                        # sandbox | live
FEDAPAY_PUBLIC_KEY=pk_sandbox_xxx
FEDAPAY_SECRET_KEY=sk_sandbox_xxx
FEDAPAY_WEBHOOK_SECRET=whsec_xxx            # à régénérer après changement d'URL de webhook : https://<DOMAIN>/api/webhooks/fedapay
# Les deux jeux de clés, pour basculer sans ressaisie : deploy/vps/fedapay-mode.sh sandbox | live
# (recopie le jeu choisi dans les quatre variables ci-dessus, seules lues par l'API).
FEDAPAY_SANDBOX_PUBLIC_KEY=pk_sandbox_xxx
FEDAPAY_SANDBOX_SECRET_KEY=sk_sandbox_xxx
FEDAPAY_SANDBOX_WEBHOOK_SECRET=              # secret de l'endpoint webhook déclaré dans le tableau de bord SANDBOX
FEDAPAY_LIVE_PUBLIC_KEY=pk_live_xxx
FEDAPAY_LIVE_SECRET_KEY=sk_live_xxx
FEDAPAY_LIVE_WEBHOOK_SECRET=                 # secret de l'endpoint webhook déclaré dans le tableau de bord LIVE
JOBS_ENABLED=true                           # ordonnanceur des jobs dans le service worker
PLATFORM_WALLET_ID=

# --- DomiCares Academy (API partenaires Akambi v1, docs/academy) ---
ACADEMY_ENABLED=false                       # true : AKAMBI_PROVIDER=akambi obligatoire en production
AKAMBI_PROVIDER=fake                        # akambi une fois la clé et le secret renseignés (sinon l'API refuse de démarrer)
AKAMBI_BASE_URL=https://preprod.akambiconsulting.com   # production : https://www.akambiconsulting.com
AKAMBI_API_KEY=                             # transmis séparément par Akambi, propre à chaque environnement
AKAMBI_API_SECRET=
AKAMBI_WEBHOOK_SECRETS=                     # whsec_… ; URL à déclarer chez Akambi : https://<DOMAIN>/api/webhooks/akambi
APP_BASE_URL=https://domicares.life

# --- SMS / OTP Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# --- E-mail (Resend utilisé par _shared/notifications.ts) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@domicares.life
# Boîte réelle de réception du formulaire public ; vide = formulaire indisponible.
CONTACT_RECIPIENT_EMAIL=
NOTIFICATION_EMAIL_FROM=noreply@domicares.life
SITE_URL=https://domicares.life
FRONTEND_URL=https://domicares.life

# --- Push Web (VAPID : npx web-push generate-vapid-keys) ---
PUSH_PROVIDER=webpush                       # webpush | console (console interdit en production)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_EMAIL=mailto:admin@domicares.life

# --- Temps réel (Socket.IO dans l'API, /socket.io routé par Caddy) ---
REALTIME_ENABLED=true

# --- Cartes ---
MAPBOX_TOKEN=

# --- Stockage S3 (MinIO local ou Wasabi) ---
S3_ENDPOINT=http://minio:9000               # ou https://s3.eu-central-1.wasabisys.com
S3_REGION=us-east-1
S3_BUCKET_DOCUMENTS=documents
S3_BUCKET_AVATARS=avatars
S3_BUCKET_ATTACHMENTS=message-attachments
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
