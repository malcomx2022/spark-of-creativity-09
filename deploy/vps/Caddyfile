# Reverse proxy Domicares — TLS automatique (Let's Encrypt)
{
  email {$ACME_EMAIL}
}

{$DOMAIN} {
  encode zstd gzip

  # API REST + WebSocket (Socket.IO) → back-end NestJS
  # « handle » et non « handle_path » : handle_path retire le préfixe qu'il a filtré, or
  # l'API monte ses routes sous API_PREFIX=api (setGlobalPrefix). Avec handle_path, un appel
  # à /api/health arrivait à NestJS sur /health et repartait en 404 « Cannot GET /health ».
  handle /api/* {
    reverse_proxy api:3000
  }
  handle /socket.io/* {
    reverse_proxy api:3000
  }
  # Webhook FedaPay : POST https://<DOMAIN>/api/webhooks/fedapay (géré par l'API)

  # Front (SPA) — fallback index.html géré par nginx dans l'image web
  handle {
    reverse_proxy web:80
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }
  log {
    output file /data/access.log
  }
}

# WWW_DOMAIN = www.<domaine> en production ; www.localhost en recette (sous-domaine sans
# enregistrement DNS : Caddy demanderait un certificat Let's Encrypt en boucle et échouerait).
{$WWW_DOMAIN:www.localhost} {
  redir https://{$DOMAIN}{uri} permanent
}

# Console MinIO (optionnel, à protéger) : files.{$DOMAIN} → minio:9000
