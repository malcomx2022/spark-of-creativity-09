# ==============================================
# Configuration pour Déploiement Supabase Externe
# ==============================================
# Copier ce fichier et remplir les valeurs
# Puis exécuter: supabase secrets set --env-file .env.external-supabase --project-ref <VOTRE_PROJECT_REF>

# ==============================================
# 1. SUPABASE (OBLIGATOIRE)
# ==============================================
# Récupérer depuis: Supabase Dashboard > Settings > API
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# ==============================================
# 2. STOCKAGE DE FICHIERS (Supabase Storage natif)
# ==============================================
# ⚠️ WASABI N'EST PLUS UTILISÉ - Le stockage a été migré vers Supabase Storage natif.
# Les secrets WASABI_* ci-dessous ne sont plus nécessaires.
# Les Edge Functions 'upload-to-wasabi' et 'get-presigned-url' utilisent désormais
# les buckets Supabase Storage ('documents' et 'avatars').
#
# Sur l'instance externe, créer les buckets manuellement :
#   INSERT INTO storage.buckets (id, name, public) VALUES ('documents', 'documents', false);
#   INSERT INTO storage.buckets (id, name, public) VALUES ('avatars', 'avatars', true);
#
# Les anciens secrets Wasabi peuvent être ignorés :
# WASABI_ACCESS_KEY_ID=non_utilisé
# WASABI_SECRET_ACCESS_KEY=non_utilisé
# WASABI_BUCKET_NAME=non_utilisé
# WASABI_REGION=non_utilisé
# WASABI_ENDPOINT=non_utilisé

# ==============================================
# 3. FEDAPAY (OBLIGATOIRE pour paiements)
# ==============================================
# Utilisé par: create-payment, payment-webhook, create-payout, etc.
# Récupérer depuis: https://app.fedapay.com/
FEDAPAY_PUBLIC_KEY=pk_sandbox_xxx ou pk_live_xxx
FEDAPAY_SECRET_KEY=sk_sandbox_xxx ou sk_live_xxx
FEDAPAY_WEBHOOK_SECRET=whsec_xxx
FEDAPAY_MODE=sandbox
PLATFORM_WALLET_ID=votre_wallet_id_plateforme

# ==============================================
# 4. TWILIO (OBLIGATOIRE pour OTP/SMS)
# ==============================================
# Utilisé par: send-otp, verify-otp, send-registration-notification
# Récupérer depuis: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=votre_auth_token_twilio
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+22890123456

# ==============================================
# 5. MAPBOX (OBLIGATOIRE pour géolocalisation)
# ==============================================
# Utilisé par: get-mapbox-token
# Récupérer depuis: https://account.mapbox.com/
MAPBOX_TOKEN=pk.eyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================
# 6. WEB PUSH NOTIFICATIONS (OPTIONNEL)
# ==============================================
# Utilisé par: send-push-notification
# Générer avec: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=votre_vapid_public_key
WEB_PUSH_PRIVATE_KEY=votre_vapid_private_key
WEB_PUSH_EMAIL=mailto:contact@votre-domaine.com

# ==============================================
# 7. EMAIL (OPTIONNEL - choisir un provider)
# ==============================================
# Utilisé par: send-registration-notification, send-kyc-status-notification
# Option A: Resend
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Option B: SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxx

# ==============================================
# COMMANDES DE DÉPLOIEMENT
# ==============================================
# 1. Configurer les secrets:
#    supabase secrets set --env-file .env.external-supabase --project-ref <REF>
#
# 2. Déployer les Edge Functions:
#    supabase functions deploy --project-ref <REF>
#
# 3. Vérifier le déploiement:
#    supabase functions list --project-ref <REF>
#
# 4. Voir les logs en cas d'erreur:
#    supabase functions logs create-practitioner-account --project-ref <REF>
