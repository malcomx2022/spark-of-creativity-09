# ==============================================
# Configuration Supabase Self-Hosted Production
# ==============================================

# Base de données
POSTGRES_PASSWORD=votre_super_mot_de_passe_securise_changez_moi
POSTGRES_DB=postgres

# JWT & Auth (GÉNÉRER DE NOUVELLES CLÉS!)
# Générer avec: openssl rand -base64 32
JWT_SECRET=votre_jwt_secret_changez_moi_minimum_32_caracteres

# ANON KEY (Générer avec supabase CLI)
# supabase gen keys --anon
ANON_KEY=votre_anon_key_genere_par_supabase_cli

# SERVICE ROLE KEY (Générer avec supabase CLI)
# supabase gen keys --service-role
SERVICE_ROLE_KEY=votre_service_role_key_genere_par_supabase_cli

# URLs
API_EXTERNAL_URL=https://api.votre-domaine.com
SITE_URL=https://votre-domaine.com
ADDITIONAL_REDIRECT_URLS=https://votre-domaine.com/**,https://www.votre-domaine.com/**

# SMTP Configuration (pour emails de confirmation)
SMTP_ADMIN_EMAIL=noreply@votre-domaine.com
SMTP_HOST=smtp.votre-provider.com
SMTP_PORT=587
SMTP_USER=votre_user_smtp
SMTP_PASS=votre_password_smtp
SMTP_SENDER_NAME=Votre Application

# Studio (Admin Dashboard)
STUDIO_DEFAULT_ORGANIZATION=Votre Organisation
STUDIO_DEFAULT_PROJECT=Votre Projet

# ==============================================
# Services Externes (à copier depuis Lovable)
# ==============================================

# FedaPay
FEDAPAY_SECRET_KEY=sk_live_votre_cle_secrete_fedapay
FEDAPAY_PUBLIC_KEY=pk_live_votre_cle_publique_fedapay
FEDAPAY_WEBHOOK_SECRET=votre_webhook_secret_fedapay
FEDAPAY_MODE=live
PLATFORM_WALLET_ID=votre_wallet_id_fedapay

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=votre_auth_token_twilio
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+22790000000

# Wasabi S3
WASABI_ACCESS_KEY_ID=votre_access_key_wasabi
WASABI_SECRET_ACCESS_KEY=votre_secret_key_wasabi
WASABI_BUCKET_NAME=votre-bucket-name
WASABI_REGION=us-east-1
WASABI_ENDPOINT=s3.wasabisys.com

# Web Push Notifications
WEB_PUSH_PUBLIC_KEY=votre_vapid_public_key
WEB_PUSH_PRIVATE_KEY=votre_vapid_private_key
WEB_PUSH_EMAIL=mailto:contact@votre-domaine.com

# Mapbox
VITE_MAPBOX_TOKEN=pk.eyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Encryption
PHONE_ENCRYPTION_KEY=votre_cle_encryption_32_caracteres_minimum
