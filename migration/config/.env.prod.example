# ================================================
# Configuration PRODUCTION - Supabase Self-Hosted
# ================================================

# ======================
# PostgreSQL Database
# ======================
POSTGRES_DB=postgres
POSTGRES_PASSWORD=votre_super_mot_de_passe_securise_changez_moi
POSTGRES_PORT=5432

# ======================
# JWT et Authentication
# ======================
# JWT Secret (minimum 32 caractères)
JWT_SECRET=votre_jwt_secret_changez_moi_minimum_32_caracteres

# Générer avec: supabase gen keys --anon --jwt-secret <JWT_SECRET>
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InByb2QiLCJyb2xlIjoiYW5vbiIsImlhdCI6MTYwMzk2ODgzNCwiZXhwIjoyNTM0MDYzNjM0fQ.changez_moi

# Générer avec: supabase gen keys --service-role --jwt-secret <JWT_SECRET>
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InByb2QiLCJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNjAzOTY4ODM0LCJleHAiOjI1MzQwNjM2MzR9.changez_moi

# ======================
# URLs
# ======================
SUPABASE_URL=https://domicares.life/api
API_EXTERNAL_URL=https://domicares.life/api
SUPABASE_PUBLIC_URL=https://domicares.life
SITE_URL=https://domicares.life

# URLs de redirection autorisées (séparées par des virgules)
ADDITIONAL_REDIRECT_URLS=https://domicares.life,https://www.domicares.life

# ======================
# Studio (Admin Dashboard)
# ======================
STUDIO_DEFAULT_ORGANIZATION="DomiCares Production"
STUDIO_DEFAULT_PROJECT="domicares-prod"
STUDIO_PG_META_URL=http://meta:8080

# ======================
# Email (SMTP)
# ======================
SMTP_ADMIN_EMAIL=noreply@domicares.life
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASS=votre_mot_de_passe_app
SMTP_SENDER_NAME="DomiCares"

# Auth Email Settings
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
DISABLE_SIGNUP=false

# ======================
# Services Externes (PRODUCTION)
# ======================

# FedaPay (Paiements - MODE LIVE)
FEDAPAY_SECRET_KEY=sk_live_votre_cle_secrete_fedapay
FEDAPAY_PUBLIC_KEY=pk_live_votre_cle_publique_fedapay
FEDAPAY_WEBHOOK_SECRET=whsec_votre_webhook_secret
PLATFORM_WALLET_ID=votre_wallet_id_plateforme

# Twilio (SMS - PRODUCTION)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=votre_auth_token_twilio
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+22890123456

# Wasabi S3 (Stockage fichiers - PRODUCTION)
WASABI_ACCESS_KEY_ID=votre_access_key_wasabi
WASABI_SECRET_ACCESS_KEY=votre_secret_key_wasabi
WASABI_BUCKET_NAME=domicares-prod-storage
WASABI_REGION=eu-central-1
WASABI_ENDPOINT=https://s3.eu-central-1.wasabisys.com

# Web Push Notifications
WEB_PUSH_PUBLIC_KEY=votre_public_key_web_push
WEB_PUSH_PRIVATE_KEY=votre_private_key_web_push
WEB_PUSH_EMAIL=mailto:contact@domicares.life

# Mapbox (Géolocalisation)
VITE_MAPBOX_TOKEN=pk.votre_token_mapbox

# ======================
# Sécurité
# ======================
# Clé d'encryption pour les numéros de téléphone (32 caractères minimum)
PHONE_ENCRYPTION_KEY=votre_cle_encryption_32_caracteres_minimum

# ======================
# Monitoring & Logs
# ======================
LOG_LEVEL=info
PGRST_LOG_LEVEL=info
GOTRUE_LOG_LEVEL=info
