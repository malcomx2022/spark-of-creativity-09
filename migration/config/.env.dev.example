# ================================================
# Configuration DEV - Supabase Self-Hosted
# ================================================

# ======================
# PostgreSQL Database
# ======================
POSTGRES_DB=postgres
POSTGRES_PASSWORD=votre_mot_de_passe_dev_changez_moi
POSTGRES_PORT=5434

# ======================
# JWT et Authentication
# ======================
# JWT Secret (minimum 32 caractères)
JWT_SECRET=votre_jwt_secret_dev_changez_moi_minimum_32_caracteres

# Générer avec: supabase gen keys --anon --jwt-secret <JWT_SECRET>
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRldiIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNjAzOTY4ODM0LCJleHAiOjI1MzQwNjM2MzR9.changez_moi

# Générer avec: supabase gen keys --service-role --jwt-secret <JWT_SECRET>
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImRldiIsInJvbGUiOiJzZXJ2aWNlX3JvbGUiLCJpYXQiOjE2MDM5Njg4MzQsImV4cCI6MjUzNDA2MzYzNH0.changez_moi

# ======================
# URLs
# ======================
SUPABASE_URL=https://dev.domicares.life/api
API_EXTERNAL_URL=https://dev.domicares.life/api
SUPABASE_PUBLIC_URL=https://dev.domicares.life
SITE_URL=https://dev.domicares.life

# URLs de redirection autorisées
ADDITIONAL_REDIRECT_URLS=https://dev.domicares.life,http://localhost:3000

# ======================
# Studio (Admin Dashboard)
# ======================
STUDIO_DEFAULT_ORGANIZATION="DomiCares Dev"
STUDIO_DEFAULT_PROJECT="domicares-dev"
STUDIO_PG_META_URL=http://meta:8080

# ======================
# Email (SMTP)
# ======================
SMTP_ADMIN_EMAIL=dev-noreply@domicares.life
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email_dev@gmail.com
SMTP_PASS=votre_mot_de_passe_app_dev
SMTP_SENDER_NAME="DomiCares Dev"

# Auth Email Settings
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
DISABLE_SIGNUP=false

# ======================
# Services Externes (DEV/SANDBOX)
# ======================

# FedaPay (Paiements - MODE SANDBOX)
FEDAPAY_SECRET_KEY=sk_sandbox_votre_cle_secrete_dev
FEDAPAY_PUBLIC_KEY=pk_sandbox_votre_cle_publique_dev
FEDAPAY_WEBHOOK_SECRET=whsec_dev_votre_webhook_secret
PLATFORM_WALLET_ID=votre_wallet_id_dev

# Twilio (SMS - TEST)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=votre_auth_token_dev
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15005550006

# Wasabi S3 (Stockage fichiers - DEV)
WASABI_ACCESS_KEY_ID=votre_access_key_dev
WASABI_SECRET_ACCESS_KEY=votre_secret_key_dev
WASABI_BUCKET_NAME=domicares-dev-storage
WASABI_REGION=eu-central-1
WASABI_ENDPOINT=https://s3.eu-central-1.wasabisys.com

# Web Push Notifications
WEB_PUSH_PUBLIC_KEY=votre_public_key_dev
WEB_PUSH_PRIVATE_KEY=votre_private_key_dev
WEB_PUSH_EMAIL=mailto:dev@domicares.life

# Mapbox (Géolocalisation)
VITE_MAPBOX_TOKEN=pk.votre_token_mapbox

# ======================
# Sécurité
# ======================
# Clé d'encryption pour les numéros de téléphone (32 caractères minimum)
PHONE_ENCRYPTION_KEY=votre_cle_encryption_dev_32_caracteres

# ======================
# Monitoring & Logs
# ======================
LOG_LEVEL=debug
PGRST_LOG_LEVEL=debug
GOTRUE_LOG_LEVEL=debug
