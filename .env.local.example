# Local Environment Variables
# Copy this file to .env.local and fill in your values

# FedaPay Public Key (required for payment widget)
# Get this from your FedaPay dashboard: https://app.fedapay.com/
# Sandbox: pk_sandbox_xxxxx
# Live: pk_live_xxxxx
VITE_FEDAPAY_PUBLIC_KEY=pk_sandbox_xxxxx

# FedaPay Environment
# Options: sandbox or live
VITE_FEDAPAY_ENVIRONMENT=sandbox
