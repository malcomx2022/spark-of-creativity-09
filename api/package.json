{
  "name": "domicares-api",
  "version": "0.1.0",
  "private": true,
  "description": "Back-end Domicares (NestJS + PostgreSQL natif) — remplace Supabase Auth/PostgREST/Edge Functions",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "node --watch -r ts-node/register/transpile-only src/main.ts",
    "start:worker": "node dist/worker.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.cjs --runInBand",
    "start:worker:dev": "node --watch -r ts-node/register/transpile-only src/worker.ts",
    "campaign:fedapay": "jest --config jest.campaign.config.cjs --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@fastify/cookie": "^10.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.2.3",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.2.3",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.12.7",
    "kysely": "^0.28.5",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.15.5",
    "@types/web-push": "^3.6.4",
    "jest": "^30.0.5",
    "socket.io-client": "^4.8.3",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "fastify": "$fastify",
    "js-yaml": "^4.3.2",
    "test-exclude": "^8.0.0"
  }
}
