# ---- Domicares API ----
NODE_ENV=development
PORT=3000
API_PREFIX=api
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# PostgreSQL natif (rôle domicares_app, voir db/native/010_roles.sql + 020_grants.sql)
DATABASE_URL=postgresql://domicares_app:change-me@localhost:5432/domicares

# JWT
JWT_ACCESS_SECRET=change-me-openssl-rand-hex-32
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
REQUIRE_EMAIL_VERIFICATION=true
COOKIE_SECURE=false

# E-mail : resend | console
EMAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@domicares.life

# OTP SMS : twilio | fake (fake = code fixe 123456, dev/test uniquement)
OTP_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
