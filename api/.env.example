# ---- Domicares API ----
NODE_ENV=development
PORT=3000
API_PREFIX=api
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# PostgreSQL natif (rôle domicares_app, voir db/native/010_roles.sql + 020_grants.sql)
DATABASE_URL=postgresql://domicares_app:change-me@localhost:5432/domicares

# JWT
JWT_ACCESS_SECRET=change-me-openssl-rand-hex-32
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
REQUIRE_EMAIL_VERIFICATION=true
COOKIE_SECURE=false

# E-mail : resend | console
EMAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@domicares.life

# OTP SMS : twilio | fake (fake = code fixe 123456, dev/test uniquement)
OTP_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# SMS transactionnels (notifications KYC…) : twilio | console
SMS_PROVIDER=console
TWILIO_PHONE_NUMBER=

# Stockage fichiers : s3 (MinIO / Wasabi / AWS) | fake (dev/test uniquement)
STORAGE_PROVIDER=fake
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_BUCKET_DOCUMENTS=documents
S3_BUCKET_AVATARS=avatars
S3_BUCKET_ATTACHMENTS=message-attachments
FILE_URL_TTL_SECONDS=3600

# Paiement FedaPay : fedapay | fake (dev/test uniquement)
FEDAPAY_PROVIDER=fake
FEDAPAY_MODE=sandbox
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=change-me-webhook-secret
APP_BASE_URL=http://localhost:8080          # callback après paiement (/payment/callback)
PAYMENT_PENDING_TIMEOUT_MINUTES=2
PAYMENT_SLOT_EXPIRY_MINUTES=30
PAYMENT_HOLD_PERIOD_DAYS=2
PAYMENT_STALE_SYNC_MINUTES=5
PAYMENT_STUCK_EXPIRATION_MINUTES=10
JOBS_ENABLED=true
