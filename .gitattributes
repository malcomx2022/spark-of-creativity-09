# Fins de ligne. Les scripts sont exécutés sur Linux (VPS, conteneurs, Git Bash, WSL) : un
# checkout Windows avec core.autocrlf=true les convertit en CRLF et bash échoue dès la
# première ligne (« set: pipefail: invalid option name »). On force LF sur tout ce qui est
# interprété côté serveur, et CRLF sur ce qui est propre à Windows.
* text=auto

*.sh      text eol=lf
*.mjs     text eol=lf
*.sql     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.conf    text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
Caddyfile       text eol=lf
.env.example    text eol=lf
SHA256SUMS      text eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
